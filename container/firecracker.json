# Argent Firecracker MicroVM Configuration
# Zero-knowledge container with minimal attack surface

{
  "boot-source": {
    "kernel-image-path": "/opt/argent/vmlinux",
    "initrd-path": "/opt/argent/argent-initrd.img",
    "boot-args": "console=ttyS0 reboot=k panic=1 pci=off"
  },
  "drives": [
    {
      "drive-id": "rootfs",
      "path-on-host": "/opt/argent/argent-rootfs.ext4",
      "is-root-device": true,
      "is-read-only": false
    }
  ],
  "network-interfaces": [
    {
      "iface-id": "eth0",
      "guest-mac": "02:00:00:00:00:01",
      "host-dev-name": "tap0"
    }
  ],
  "machine-config": {
    "vcpu-count": 2,
    "mem-size-mib": 2048,
    "smt": false
  },
  "kernel-config": {
    "kernel_cmdline_append": "ro console=ttyS0 noapic"
  },
  "logging": {
    "log-file": "/var/log/argent/firecracker.log",
    "level": "Info"
  },
  "metrics": {
    "metrics-file": "/var/log/argent/metrics.log"
  },
  "security-groups": [],
  "cpu-config": {
    "cpu-affinity": [0, 1]
  }
}
